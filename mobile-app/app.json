{
  "expo": {
    "name": "LithoSync",
    "slug": "lithosynch-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lithosynch",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0E1A",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0E1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ksemiz.lithosynch"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0E1A"
      },
      "package": "com.ksemiz.lithosynch"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
